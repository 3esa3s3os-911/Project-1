<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Start up Project</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #ece4d5;
      --peach: #cbb994;
      --terracotta: #a63d2f;
      --sage: #6b5a35;
      --text-dark: #2b2420;
      --text-soft: #55483e;
      --shadow-soft: 0 4px 14px rgba(43, 36, 32, 0.1);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Nunito', Arial, sans-serif; color: var(--text-dark); background: var(--cream); }

    .navbar { display: flex; align-items: center; justify-content: flex-end; padding: 0 30px; background: var(--peach); height: 50px; position: relative; box-shadow: var(--shadow-soft); }
    .navbar-center { position: absolute; top: calc(50% + 8px); left: 50%; transform: translate(-50%, -50%); text-align: center; }
    .navbar-center img { height: 200px; width: auto; display: block; margin: 0 auto; }

    .links-container { display: flex; align-items: center; gap: 22px; }
    .links-container a { text-decoration: none; color: var(--text-dark); font-weight: 600; position: relative; transition: color .25s ease; }
    .links-container a::after { content: ''; position: absolute; width: 0; height: 2px; bottom: -4px; left: 0; background: var(--terracotta); border-radius: 2px; transition: width .3s ease; }
    .links-container a:hover { color: var(--terracotta); }
    .links-container a:hover::after { width: 100%; }

    .headerbase { min-height: calc(100vh - 50px); text-align: center; padding: 20px 20px 40px; animation: fadeIn .8s ease both; }
    .hero-wrap { margin: 0 auto 8px; }
    .hero-wrap img { width: 260px; border-radius: 16px; filter: drop-shadow(0 8px 18px rgba(43, 36, 32, 0.15)); }

    .headerbase h3 { font-weight: 600; font-size: 19px; color: var(--text-soft); max-width: 560px; margin: 0 auto 12px; line-height: 1.6; }
    .headerbase a { text-decoration: none; }
    .headerbase a h3 { display: inline-block; font-family: 'Quicksand', sans-serif; font-weight: 700; color: var(--sage); margin-top: 20px; padding-bottom: 3px; border-bottom: 2px solid transparent; transition: border-color .25s ease, color .25s ease; }
    .headerbase a:hover h3 { color: var(--terracotta); border-color: var(--terracotta); }

    button { padding: 11px 28px; font-family: 'Quicksand', sans-serif; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--cream); background: var(--terracotta); border: 2px solid var(--text-dark); border-radius: 4px; cursor: pointer; margin-top: 15px; box-shadow: 4px 4px 0 var(--text-dark); transition: transform .15s ease, box-shadow .15s ease; }
    button:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--text-dark); }
    button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--text-dark); }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 600px) {
      .navbar { flex-wrap: wrap; }
      .links-container { gap: 14px; flex-wrap: wrap; justify-content: center; }
      .navbar-center img { height: 140px; }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="navbar-center">
      <img src="FitnessMoreFit__1_-removebg-preview.png" alt="FitnessMoreFit Logo">
    </div>
    <div class="links-container">
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Contact</a>
      <a href="#">Help</a>
      <a href="#">Socials</a>
    </div>
  </nav>

  <div class="headerbase">
    <div class="hero-wrap">
      <img src="./hero-image.webp" alt="Fitness hero" width="300">
    </div>

    <h3>Explore our range of products and services designed to help you achieve your fitness goals.</h3>
    <h3>Grab a product of ours and enjoy a healthier lifestyle!</h3>

    <a 
      <h3>Visit Our Channel</h3>
    </a>
    <br>
    <button onclick="alert('Thank you for viewing my page <3 !')">Contact</button>
  </div>

</body>
</html>
